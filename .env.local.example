# Local environment variables template
# Copy this file to `.env.local` and fill values (do NOT commit secrets).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: SendGrid to notify staff on new contact submissions
SENDGRID_API_KEY=
CONTACT_NOTIFICATION_EMAIL=admin@example.com

# Basic auth for /admin pages (username/password)
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASS=changeme

# Server secret used by scheduled jobs to trigger event status refresh
REFRESH_EVENTS_SECRET=replace-with-a-long-random-string
